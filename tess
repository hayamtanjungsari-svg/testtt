local function addButton(page, text, callback, danger)
	local b = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 36),
		AutoButtonColor = false,
		Text = text,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		LayoutOrder = nextOrder(page),
		Parent = page.scroll,
	})
	create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = b })
	local s = create("UIScale", { Parent = b })
	if danger then
		b.BackgroundColor3 = DANGER
		b.TextColor3 = WHITE
		hoverColor(b, function() return DANGER end, function() return DANGER:Lerp(WHITE, 0.2) end)
	else
		reg(b, "BackgroundColor3", "accent")
		reg(b, "TextColor3", "onAccent")
		hoverColor(b, function() return THEME.accent end, function() return THEME.accent:Lerp(WHITE, 0.2) end)
	end
	pressEffect(b, s)
	b.Activated:Connect(function()
		if callback then task.spawn(callback) end
	end)
	return b
end

local function addToggle(page, text, default, callback)
	local item = card(page, 38)
	cardText(item, text, UDim2.new(0, 12, 0, 0), UDim2.new(1, -70, 1, 0), "text")

	local track = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(42, 22),
		AutoButtonColor = false,
		Text = "",
		Parent = item,
	})
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = WHITE,
		Parent = track,
	})
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })
	local knobScale = create("UIScale", { Parent = knob })

	local state = default and true or false

	local function render(animate)
		local pos = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
		local col = state and THEME.accent or THEME.bg
		if animate then
			tween(knob, 0.3, { Position = pos }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			tween(track, 0.25, { BackgroundColor3 = col })
		else
			knob.Position = pos
			track.BackgroundColor3 = col
		end
	end
	render(false)

	local obj = { Frame = item }
	function obj.Get() return state end
	function obj.Set(v, silent)
		state = v and true or false
		render(true)
		if not silent and callback then task.spawn(callback, state) end
	end

	track.MouseButton1Down:Connect(function()
		tween(knobScale, 0.1, { Scale = 1.2 })
	end)
	track.Activated:Connect(function()
		obj.Set(not state)
		tween(knobScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end)
	track.MouseLeave:Connect(function()
		tween(knobScale, 0.2, { Scale = 1 })
	end)
	return obj
end

-- tarik / geser (dipakai semua slider supaya perilakunya sama)
local function dragBinder(hit, page, onInput, onBegan, onEnded)
	local sliding, slideInput = false, nil
	hit.InputBegan:Connect(function(input)
		if isPointerDown(input) then
			sliding = true
			slideInput = input
			page.scroll.ScrollingEnabled = false
			if onBegan then onBegan() end
			onInput(input)
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					sliding = false
					page.scroll.ScrollingEnabled = true
					if onEnded then onEnded() end
				end
			end)
		end
	end)
	hit.InputChanged:Connect(function(input)
		if isPointerMove(input) then slideInput = input end
	end)
	bind(UserInputService.InputChanged, function(input)
		if sliding and (input == slideInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
			onInput(input)
		end
	end)
end

-- slider; power > 1 membuat sisi kecil lebih halus (dipakai untuk jarak kabut)
local function addSlider(page, text, min, max, default, step, callback, fmt, power)
	fmt = fmt or tostring
	power = power or 1
	local item = card(page, 56)
	cardText(item, text, UDim2.new(0, 12, 0, 6), UDim2.new(1, -90, 0, 18), "text")
	local valueLabel = cardText(item, "", UDim2.new(1, -82, 0, 6), UDim2.fromOffset(70, 18),
		"accent", Enum.Font.GothamBold, 13, Enum.TextXAlignment.Right)

	local hit = create("TextButton", {
		Position = UDim2.new(0, 12, 0, 28),
		Size = UDim2.new(1, -24, 0, 24),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = item,
	})
	local bar = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0, 6),
		Parent = hit,
	})
	reg(bar, "BackgroundColor3", "bg")
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = bar })
	local fill = create("Frame", { Size = UDim2.new(0, 0, 1, 0), Parent = bar })
	reg(fill, "BackgroundColor3", "accent")
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = WHITE,
		Parent = bar,
	})
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })
	local knobScale = create("UIScale", { Parent = knob })

	local function snap(v)
		v = min + round((v - min) / step) * step
		v = math.floor(v * 1000 + 0.5) / 1000
		return math.clamp(v, min, max)
	end
	local function toAlpha(v)
		local a = math.clamp((v - min) / (max - min), 0, 1)
		return a ^ (1 / power)
	end

	local value = snap(default)
	local function setAlpha(alpha, instant)
		alpha = math.clamp(alpha, 0, 1)
		if instant then
			fill.Size = UDim2.new(alpha, 0, 1, 0)
			knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		else
			tween(fill, 0.08, { Size = UDim2.new(alpha, 0, 1, 0) }, Enum.EasingStyle.Linear)
			tween(knob, 0.08, { Position = UDim2.new(alpha, 0, 0.5, 0) }, Enum.EasingStyle.Linear)
		end
	end
	setAlpha(toAlpha(value), true)
	valueLabel.Text = fmt(value)

	local obj = { Frame = item }
	function obj.Set(v, silent)
		v = snap(v)
		value = v
		valueLabel.Text = fmt(v)
		setAlpha(toAlpha(v))
		if not silent and callback then task.spawn(callback, v) end
	end
	function obj.Get() return value end

	dragBinder(hit, page, function(input)
		local alpha = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local v = snap(min + (max - min) * (alpha ^ power))
		setAlpha(toAlpha(v))
		if v ~= value then
			value = v
			valueLabel.Text = fmt(v)
			if callback then task.spawn(callback, v) end
		end
	end, function()
		tween(knobScale, 0.15, { Scale = 1.3 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end, function()
		tween(knobScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end)
	return obj
end

-- pemilih warna: tiga slider R/G/B + kotak pratinjau
local function addColor(page, text, default, callback)
	local item = card(page, 108)
	cardText(item, text, UDim2.new(0, 12, 0, 4), UDim2.new(1, -70, 0, 18), "text")
	local swatch = create("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 6),
		Size = UDim2.fromOffset(34, 16),
		BackgroundColor3 = default,
		BorderSizePixel = 0,
		Parent = item,
	})
	create("UICorner", { CornerRadius = UDim.new(0, 5), Parent = swatch })
	create("UIStroke", { Color = WHITE, Transparency = 0.7, Thickness = 1, Parent = swatch })

	local chans = { R = round(default.R * 255), G = round(default.G * 255), B = round(default.B * 255) }
	local function current() return Color3.fromRGB(chans.R, chans.G, chans.B) end
	local rows = {}

	local specs = { { "R", rgb(235, 87, 87) }, { "G", rgb(80, 220, 110) }, { "B", rgb(80, 140, 255) } }
	for i, s in ipairs(specs) do
		local key = s[1]
		local y = 26 + (i - 1) * 26
		cardText(item, key, UDim2.new(0, 12, 0, y), UDim2.fromOffset(14, 22), "subtext", Enum.Font.GothamBold, 11)
		local val = cardText(item, tostring(chans[key]), UDim2.new(1, -46, 0, y), UDim2.fromOffset(36, 22),
			"accent", Enum.Font.GothamBold, 11, Enum.TextXAlignment.Right)
		local hit = create("TextButton", {
			Position = UDim2.new(0, 30, 0, y),
			Size = UDim2.new(1, -84, 0, 22),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Parent = item,
		})
		local bar = create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.new(1, 0, 0, 5),
			Parent = hit,
		})
		reg(bar, "BackgroundColor3", "bg")
		create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = bar })
		local fill = create("Frame", {
			Size = UDim2.new(chans[key] / 255, 0, 1, 0),
			BackgroundColor3 = s[2],
			BorderSizePixel = 0,
			Parent = bar,
		})
		create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })
		local knob = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(chans[key] / 255, 0, 0.5, 0),
			Size = UDim2.fromOffset(12, 12),
			BackgroundColor3 = WHITE,
			Parent = bar,
		})
		create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })
		rows[key] = { val = val, fill = fill, knob = knob }

		dragBinder(hit, page, function(input)
			local alpha = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
			local v = round(alpha * 255)
			if v ~= chans[key] then
				chans[key] = v
				val.Text = tostring(v)
				fill.Size = UDim2.new(v / 255, 0, 1, 0)
				knob.Position = UDim2.new(v / 255, 0, 0.5, 0)
				local c = current()
				swatch.BackgroundColor3 = c
				if callback then task.spawn(callback, c) end
			end
		end)
	end

	local obj = { Frame = item }
	function obj.Get() return current() end
	function obj.Set(c, silent)
		chans.R, chans.G, chans.B = round(c.R * 255), round(c.G * 255), round(c.B * 255)
		for key, r in pairs(rows) do
			r.val.Text = tostring(chans[key])
			r.fill.Size = UDim2.new(chans[key] / 255, 0, 1, 0)
			r.knob.Position = UDim2.new(chans[key] / 255, 0, 0.5, 0)
		end
		swatch.BackgroundColor3 = current()
		if not silent and callback then task.spawn(callback, current()) end
	end
	return obj
end

