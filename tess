local function addPicker(page, text, options, default, onChange)
	local item = card(page, 150)
	cardText(item, text, UDim2.new(0, 12, 0, 4), UDim2.new(0.4, 0, 0, 18), "text")
	local valueLbl = cardText(item, default, UDim2.new(0.4, 0, 0, 4), UDim2.new(0.6, -12, 0, 18),
		"accent", Enum.Font.GothamBold, 12, Enum.TextXAlignment.Right)
	local list = create("ScrollingFrame", {
		Position = UDim2.new(0, 8, 0, 26),
		Size = UDim2.new(1, -16, 1, -34),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = item,
	})
	reg(list, "ScrollBarImageColor3", "accent")
	create("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

	local cur = default
	local btns = {}
	local function paint()
		for name, b in pairs(btns) do
			local sel = name == cur
			b.BackgroundColor3 = sel and THEME.accent or THEME.bg
			b.TextColor3 = sel and THEME.onAccent or THEME.text
		end
	end
	for i, name in ipairs(options) do
		local b = create("TextButton", {
			Size = UDim2.new(1, -6, 0, 24),
			LayoutOrder = i,
			AutoButtonColor = false,
			Text = name,
			Font = Enum.Font.GothamMedium,
			TextSize = 12,
			BorderSizePixel = 0,
			Parent = list,
		})
		create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = b })
		btns[name] = b
		b.Activated:Connect(function()
			cur = name
			valueLbl.Text = name
			paint()
			if onChange then onChange(name) end
		end)
	end
	paint()
	return {
		Frame = item,
		Set = function(n)
			cur = n
			valueLbl.Text = n
			paint()
		end,
	}
end

local function addKeybind(page, text, getKey, onSet)
	local item = card(page, 38)
	cardText(item, text, UDim2.new(0, 12, 0, 0), UDim2.new(1, -140, 1, 0), "text")
	local btn = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(110, 24),
		AutoButtonColor = false,
		Text = getKey().Name,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		Parent = item,
	})
	reg(btn, "BackgroundColor3", "accent")
	reg(btn, "TextColor3", "onAccent")
	create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = btn })
	local s = create("UIScale", { Parent = btn })
	pressEffect(btn, s)

	btn.Activated:Connect(function()
		if keyCapture then return end
		btn.Text = "Tekan tombol..."
		keyCapture = function(keyCode)
			if keyCode == Enum.KeyCode.Escape then
				btn.Text = getKey().Name
				return
			end
			onSet(keyCode)
			btn.Text = keyCode.Name
		end
	end)
	return { Set = function(name) btn.Text = name end }
end

