-- pilihan segmen (satu baris, beberapa pilihan, satu aktif)
local function addSegment(page, options, default, onChange)
	local item = card(page, 38)
	local n = #options
	local btns, currentKey = {}, default
	local function paint()
		for key, b in pairs(btns) do
			local sel = key == currentKey
			tween(b, 0.2, {
				BackgroundColor3 = sel and THEME.accent or THEME.bg,
				TextColor3 = sel and THEME.onAccent or THEME.text,
			})
		end
	end
	for i, o in ipairs(options) do
		local b = create("TextButton", {
			Position = UDim2.new((i - 1) / n, 4, 0, 5),
			Size = UDim2.new(1 / n, -8, 1, -10),
			AutoButtonColor = false,
			Text = o[2],
			Font = Enum.Font.GothamBold,
			TextSize = 11,
			BackgroundColor3 = THEME.bg,
			TextColor3 = THEME.text,
			Parent = item,
		})
		create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = b })
		btns[o[1]] = b
		b.Activated:Connect(function()
			currentKey = o[1]
			paint()
			onChange(o[1])
		end)
	end
	paint()
	return { Set = function(k) currentKey = k paint() end }
end

