	local item = card(page, 54)
	cardText(item, label, UDim2.new(0, 12, 0, 4), UDim2.new(1, -24, 0, 16), "subtext", Enum.Font.GothamMedium, 11)
	local box = create("TextBox", {
		Position = UDim2.new(0, 10, 0, 24),
		Size = UDim2.new(1, -20, 0, 24),
		Text = "",
		PlaceholderText = placeholder,
		PlaceholderColor3 = THEME.subtext,
		ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		BorderSizePixel = 0,
		Parent = item,
	})
	reg(box, "BackgroundColor3", "bg")
	reg(box, "TextColor3", "text")
	create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = box })
	create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = box })
	local stroke = create("UIStroke", {
		Color = THEME.accent,
		Thickness = 1,
		Transparency = 0.75,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = box,
	})
	box.Focused:Connect(function() tween(stroke, 0.2, { Transparency = 0 }) end)
	box.FocusLost:Connect(function(enter)
		tween(stroke, 0.25, { Transparency = 0.75 })
		if onSubmit then onSubmit(box.Text, enter) end
	end)
	return {
		Get = function() return box.Text end,
		Set = function(t) box.Text = t end,
	}
end


