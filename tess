-- ===== MESIN MEMANCING =====
local function getRod()
	local char = player.Character
	if not char then return nil end
	for _, obj in ipairs(char:GetChildren()) do
		if obj:IsA("Tool") and obj.Name:lower():find("rod") then return obj end
	end
	return nil
end

local function getNilEvent()
	if H.nilEv and H.nilEv.Parent == nil then return H.nilEv end
	if not getnilinstances or tick() - H.nilTry < 10 then return nil end
	H.nilTry = tick()
	pcall(function()
		for _, obj in ipairs(getnilinstances()) do
			if obj.Name == "Event" and obj:GetDebugId() == "0_2453761" then
				H.nilEv = obj
				break
			end
		end
	end)
	return H.nilEv
end

local function doEquip()
	local rod = getRod()
	if not rod or not H.rodRemote then return false end
	local nilEv = getNilEvent()
	if nilEv then pcall(function() nilEv:Fire({ IsEquipped = true, Tool = rod, SlotNumber = 1 }) end) end
	pcall(function() H.rodRemote:FireServer("Equipped", rod) end)
	return true
end

local function doThrow()
	local rod = getRod()
	if not rod or not H.rodRemote then return false end
	pcall(function() H.rodRemote:FireServer("Throw", nil, rod) end)
	return true
end

local PG = player:WaitForChild("PlayerGui")
local cachedMini = nil
local function findMini()
	local c = cachedMini
	if c and c.gui.Parent and c.gui.Enabled and c.wb.Parent and c.rb.Parent then
		return c.gui, c.wb, c.rb
	end
	cachedMini = nil
	for _, gui in ipairs(PG:GetChildren()) do
		if gui:IsA("ScreenGui") and gui.Enabled and gui ~= screen then
			local mf = gui:FindFirstChild("MainFrame")
			local fr = mf and mf:FindFirstChild("Frame")
			local wb = fr and fr:FindFirstChild("WhiteBar")
			local rb = fr and fr:FindFirstChild("RedBar")
			if wb and rb then
				cachedMini = { gui = gui, wb = wb, rb = rb }
				return gui, wb, rb
			end
		end
	end
	return nil, nil, nil
end

local VIM = nil
pcall(function() VIM = game:GetService("VirtualInputManager") end)

-- menahan klik: mouse1press (PC / sebagian executor), cadangan VirtualInputManager (Delta / Android)
local function holdPos()
	local c = cachedMini
	if c and c.rb.Parent then return c.rb.AbsolutePosition + c.rb.AbsoluteSize / 2 end
	return camera.ViewportSize / 2
end

local function pressDown()
	local m = H.holdMode
	if (m == "auto" or m == "mouse") and mouse1press then
		if pcall(mouse1press) then
			H.holdUsed = "mouse"
			return true
		end
	end
	if (m == "auto" or m == "vim") and VIM then
		local p = holdPos()
		if pcall(function() VIM:SendMouseButtonEvent(p.X, p.Y, 0, true, game, 0) end) then
			H.holdUsed, H.pressPos = "vim", p
			return true
		end
	end
	return false
end

local function pressUp()
	if H.holdUsed == "mouse" then
		if mouse1release then pcall(mouse1release) end
	elseif H.holdUsed == "vim" and VIM then
		local p = H.pressPos or camera.ViewportSize / 2
		pcall(function() VIM:SendMouseButtonEvent(p.X, p.Y, 0, false, game, 0) end)
	end
	H.holdUsed = nil
end

local function setHold(v)
	if v == H.holding then return end
	if v then
		H.holding = pressDown()
	else
		H.holding = false
		pressUp()
	end
end

local function centerX(f) return f.AbsolutePosition.X + f.AbsoluteSize.X * 0.5 end

local function setFishStatus(t) if fishStatus then fishStatus.Set(t) end end

local function fishCycle()
	local F = H.fish
	if not doEquip() then
		setFishStatus(H.rodRemote and "Rod tidak ada di karakter" or "Remote Rod tidak ada")
		task.wait(2)
		return
	end
	setFishStatus("Melempar...")
	task.wait(0.4)
	if not F.on then return end
	doThrow()
	task.wait(F.throwDelay)
	if not F.on then return end

	setFishStatus("Menunggu ikan...")
	local waited = 0
	local gui = findMini()
	while not gui and F.on and waited < F.biteTimeout do
		task.wait(0.1)
		waited = waited + 0.1
		gui = findMini()
	end
	if not F.on then return end
	if not gui then
		task.wait(0.3)
		return
	end

	setFishStatus("Minigame...")
	local timer = 0
	while F.on do
		local g, wb, rb = findMini()
		if not g then break end
		local diff = centerX(rb) - centerX(wb)
		if diff > F.deadzone then setHold(true) elseif diff < -F.deadzone then setHold(false) end
		task.wait(0.016)
		timer = timer + 0.016
		if timer >= F.miniTimeout then break end
	end
	setHold(false)
	if timer < F.miniTimeout then
		F.count = F.count + 1
		if fishCount then fishCount.Set(F.count) end
	end
	task.wait(F.rethrow)
end

local function stopFish()
	H.fish.on = false
	H.fish.token = H.fish.token + 1
	setHold(false)
	setFishStatus("Mati")
end

local function startFish()
	local F = H.fish
	if F.on then return end
	if not mouse1press and not VIM then notify("Executor tidak bisa menahan klik (tidak ada mouse1press / VirtualInputManager)") end
	F.on = true
	F.token = F.token + 1
	local tk = F.token
	task.spawn(function()
		while F.on and F.token == tk and not closing do
			local ok = pcall(fishCycle)
			if not ok then task.wait(0.5) end
		end
		setHold(false)
	end)
end

-- ===== MESIN MINING =====
local function getHRP()
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function getCrystals()
	local out = {}
	local mc = Workspace:FindFirstChild("MapContent")
	local folder = mc and mc:FindFirstChild("Crystals")
	if not folder then return out end
	for _, obj in ipairs(folder:GetChildren()) do
		if obj.Name:lower() == "crystal" then out[#out + 1] = obj end
	end
	return out
end

local function crystalPos(c)
	if c:IsA("BasePart") then return c.Position end
	if c:IsA("Model") then
		local ok, cf = pcall(function() return c:GetPivot() end)
		if ok and cf then return cf.Position end
	end
	if c.PrimaryPart then return c.PrimaryPart.Position end
	return nil
end

local function closestCrystal()
	local hrp = getHRP()
	if not hrp then return nil end
	local best, bestD, bestPos = nil, math.huge, nil
	for _, c in ipairs(getCrystals()) do
		local p = crystalPos(c)
		if p then
			local d = (hrp.Position - p).Magnitude
			if d < bestD then best, bestD, bestPos = c, d, p end
		end
	end
	return best, bestPos
end

local function setMineStatus(t) if mineStatus then mineStatus.Set(t) end end

local function stopMine()
	local M = H.mine
	local was = M.on
	M.on = false
	M.token = M.token + 1
	setMineStatus("Mati")
	if was and M.back and M.home then
		local hrp = getHRP()
		if hrp then hrp.CFrame = M.home end
	end
	M.home = nil
end

local function startMine()
	local M = H.mine
	if M.on then return end
	if not H.pickRemote then notify("Remote Pickaxe tidak ditemukan") end
	M.on = true
	M.token = M.token + 1
	local tk = M.token
	local hrp0 = getHRP()
	M.home = hrp0 and hrp0.CFrame or nil
	task.spawn(function()
		while M.on and M.token == tk and not closing do
			pcall(function()
				local crystal, pos = closestCrystal()
				local hrp = getHRP()
				if crystal and pos and hrp then
					local d = (hrp.Position - pos).Magnitude
					if d > M.offset + 2 then
						if M.tp then
							local target = pos + Vector3.new(M.offset, 2, 0)
							hrp.CFrame = CFrame.lookAt(target, Vector3.new(pos.X, target.Y, pos.Z))
							task.wait(0.05)
						end
					else
						hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(pos.X, hrp.Position.Y, pos.Z))
					end
					if H.pickRemote then
						for _ = 1, M.hits do
							H.pickRemote:FireServer("Hit")
						end
						M.hitsDone = M.hitsDone + M.hits
					end
					setMineStatus("Menambang ✓")
				else
					setMineStatus("Mencari kristal...")
				end
			end)
			task.wait(M.delay)
		end
	end)
end

-- ===== ESP KRISTAL =====
local function clearESP()
	local E = H.esp
	for _, o in pairs(E.boxes) do pcall(function() o:Destroy() end) end
	for _, o in pairs(E.beams) do pcall(function() o:Destroy() end) end
	for _, o in pairs(E.atts) do pcall(function() o:Destroy() end) end
	if E.me then pcall(function() E.me:Destroy() end) end
	E.boxes, E.beams, E.atts, E.me = {}, {}, {}, nil
end

local function espRefresh()
	local E = H.esp
	if not E.folder then
		E.folder = create("Folder", { Name = "WarpahHangoutESP", Parent = guiParent })
	end
	local hrp = getHRP()
	if not E.me then
		E.me = create("Attachment", { Parent = Workspace.Terrain })
	end
	if hrp then E.me.WorldPosition = hrp.Position end
	local now = tick()
	if now - E.lastSet < 2 then return end
	E.lastSet = now
	local alive = {}
	for _, c in ipairs(getCrystals()) do
		alive[c] = true
		if not E.boxes[c] then
			local p = crystalPos(c)
			if p then
				E.boxes[c] = create("SelectionBox", {
					Adornee = c, Color3 = rgb(0, 255, 150), LineThickness = 0.05,
					SurfaceTransparency = 0.6, SurfaceColor3 = rgb(0, 255, 100), Parent = E.folder,
				})
				local a1 = create("Attachment", { Parent = Workspace.Terrain })
				a1.WorldPosition = p
				E.atts[c] = a1
				E.beams[c] = create("Beam", {
					Attachment0 = E.me, Attachment1 = a1, Color = ColorSequence.new(rgb(0, 255, 150)),
					LightEmission = 0.8, FaceCamera = true, Width0 = 0.08, Width1 = 0.08,
					Transparency = NumberSequence.new(0.3), Parent = E.folder,
				})
			end
		end
	end
	for c, _ in pairs(E.boxes) do
		if not alive[c] or not c.Parent then
			pcall(function() E.boxes[c]:Destroy() end)
			pcall(function() E.beams[c]:Destroy() end)
			pcall(function() E.atts[c]:Destroy() end)
			E.boxes[c], E.beams[c], E.atts[c] = nil, nil, nil
		end
	end
	if crystalInfo then crystalInfo.Set(#getCrystals()) end
end

local espAcc = 0
bind(RunService.Heartbeat, function(dt)
	if not H.mine.esp or closing then return end
	espAcc = espAcc + dt
	if espAcc >= 0.3 then
		espAcc = 0
		pcall(espRefresh)
	end
end)

local function setESP(on)
	H.mine.esp = on
	if on then
		H.esp.lastSet = 0
		pcall(espRefresh)
	else
		clearESP()
	end
end

