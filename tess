	for i, s in ipairs(specs) do
		local b = create("TextButton", {
			Position = UDim2.new((i - 1) / n, 4, 0, 5),
			Size = UDim2.new(1 / n, -8, 1, -10),
			AutoButtonColor = false,
			Text = s[1],
			Font = Enum.Font.GothamBold,
			TextSize = 11,
			Parent = row,
		})
		if s[3] then
			b.BackgroundColor3 = DANGER
			b.TextColor3 = WHITE
		else
			reg(b, "BackgroundColor3", "accent")
			reg(b, "TextColor3", "onAccent")
		end
		create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = b })
		local sc = create("UIScale", { Parent = b })
		pressEffect(b, sc)
		b.Activated:Connect(function() task.spawn(s[2]) end)
	end
	return row
end

